# Copy to .env before running: cp .env.example .env

MINIO_ROOT_USER=myanflix
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Origins allowed to PUT directly to this bucket from a browser (comma-
# separated) — the admin app's own origin(s). Direct browser->MinIO
# multipart uploads (see backend's MultipartUploadService) need this;
# nothing else in this codebase does. Configured server-side via this env
# var rather than the S3 PutBucketCorsCommand API — that command is
# unusable against MinIO (confirmed: MinIO 501s on the checksum header/query
# param the AWS SDK v3 unconditionally attaches to it). In prod, set this to
# the admin app's real public origin(s).
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3002

# Public HTTPS URL for the write-side upload proxy (see ./upload-proxy) —
# used only by the backend's MINIO_PUBLIC_ENDPOINT to sign presigned URLs
# the browser will actually use. Never MinIO's own raw port.
UPLOAD_PROXY_PORT=8443

# OPTIONAL, LOCAL DEVELOPMENT ONLY — where MinIO's object store physically
# lives. Leave this unset and it uses the `minio-data` Docker named volume,
# which is the correct behaviour for production and for a fresh clone.
#
# Set it to an absolute host path to bind-mount instead, e.g. to keep a
# multi-GB library on an external drive rather than inside Docker's VM disk
# image on macOS:
#
#   MINIO_DATA_PATH=/Volumes/YOUR_SSD/minio-data
#
# The two are separate stores — switching does not migrate existing objects,
# and if the path is missing at startup Docker creates an empty directory
# there and MinIO comes up with an empty bucket. Mount the drive first.

# Only read by scripts/minio-backup.sh, never by MinIO itself. Where the
# bucket is copied: an absolute folder on ANOTHER disk (e.g.
# /Volumes/YOUR_SSD/myanflix-media), or <alias>/<bucket> on another S3/MinIO
# together with mc's MC_HOST_<alias>=https://<access-key>:<secret-key>@<host>.
# Empty = no media backup. See README.md, "Backups".
MINIO_BACKUP_TARGET=
