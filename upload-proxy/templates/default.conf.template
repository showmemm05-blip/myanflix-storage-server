upstream storage_origin {
    server ${STORAGE_ORIGIN};
    # Reuses connections to MinIO across requests instead of a fresh TCP
    # handshake per part/file — meaningful at the concurrency levels the
    # admin's small-file worker pool uses.
    keepalive 32;
}

server {
    # Local dev: plain HTTP, matching ../../cacheserver's own local setup.
    #
    # PRODUCTION TODO (ops): this must be re-fronted with TLS + HTTP/2
    # ("listen 443 ssl http2;" + ssl_certificate/ssl_certificate_key) before
    # going live — two independent hard requirements, not one:
    #  1. Mixed content: an HTTPS admin app cannot PUT to a plain-HTTP
    #     endpoint at all; browsers block it outright.
    #  2. HTTP/2 specifically (not just HTTPS) is required for the
    #     thousands-of-small-HLS-segments case to actually achieve its
    #     designed concurrency — HTTP/1.1 caps the browser to ~6 connections
    #     per origin, which silently throttles the frontend's ~16-worker
    #     small-file pool down to ~6-way real concurrency (see the upload
    #     migration plan's throughput analysis for the concrete numbers).
    # This repo has no existing TLS-termination convention to copy from
    # (checked: no cert/proxy config for the rest of the stack either) —
    # confirm with ops how prod TLS is actually terminated before wiring
    # this in, rather than inventing an independent scheme here.
    listen 8443;
    server_name _;

    # Comfortably above the 32MB multipart part size (see
    # MultipartUploadService.MULTIPART_PART_SIZE in the backend) with
    # headroom for a future part-size change — nginx's own default is 1MB,
    # which would reject every part outright.
    client_max_body_size 100m;

    # ---------------------------------------------------------------------
    # What this public port is FOR, and nothing else (security audit
    # 2026-10-06, M-25): presigned browser uploads. The backend only ever
    # presigns PutObject and UploadPart (PUT) for keys that
    # ResourceUploadTypeRegistry.buildKey builds under these four prefixes of
    # the `movies` bucket (MINIO_BUCKET):
    #   videos/<movieId>/...         movie bundle (HLS, original)
    #   subtitles/<movieId>/...      subtitle sources
    #   temp/video-replace/...       video replace staging
    #   documents/books/<bookId>/... chapter PDFs
    # Multipart create/complete/abort, HEAD/GET/LIST and every admin call go
    # from the backend straight to MinIO on :9000 (MINIO_ENDPOINT), never
    # through here. So anything that is not PUT/POST/OPTIONS under those
    # prefixes is refused by nginx itself (403, no X-Amz-Request-Id) and
    # never reaches MinIO — in particular /minio/* (health, admin API),
    # bucket listing, DELETE and any other bucket. Before this block the
    # whole S3 + admin API was reachable here for anyone holding a key,
    # which made the firewall on :9000 pointless.
    #
    # POST is allowed only so that a future presigned multipart
    # create/complete through this proxy keeps working; the browser does
    # not use it today. OPTIONS is the CORS preflight MinIO answers.
    #
    # If the bucket name or an upload prefix ever changes, change it here
    # too (the README lists this as the one thing to keep in step).
    location ~ ^/movies/(videos|subtitles|temp|documents)/ {
        limit_except PUT POST OPTIONS {
            deny all;
        }

        proxy_pass http://storage_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # $http_host, not $host — nginx's $host strips the port, but the
        # presigned URL's SigV4 signature was computed including the port
        # (this proxy listens on a non-standard port, 8443) — forwarding a
        # port-stripped Host header here makes MinIO recompute a different
        # signature than the one the client sent, and every presigned
        # request fails with SignatureDoesNotMatch. Confirmed by hitting
        # this for real: identical presigned URL worked PUT directly to
        # MinIO's own port, failed only through this proxy, until this was
        # fixed.
        proxy_set_header Host $http_host;

        # MinIO evaluates a bucket policy's aws:SourceIp condition from
        # X-Forwarded-For / X-Real-IP / Forwarded BEFORE falling back to the
        # socket address. The movies bucket policy (../../policies/) allows
        # anonymous reads only from the cache server's address — so a client
        # that could send `X-Forwarded-For: <cache ip>` through this public
        # proxy would read any object as if it were the cache. Blanking the
        # three headers (an empty value makes nginx drop the header entirely)
        # means MinIO only ever sees this proxy's own address, which the
        # policy does not list. Presigned uploads carry their credentials in
        # the signature, not in these headers, so nothing legitimate is lost.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";

        # THE critical setting for this proxy's entire purpose: without
        # this, nginx buffers the full request body to its own local disk
        # before forwarding it upstream — which would silently reintroduce
        # exactly the disk hop this migration exists to remove, just moved
        # from the backend to this box instead.
        proxy_request_buffering off;

        # No proxy_cache here, unlike ../../cacheserver's read-side proxy —
        # writes are never cacheable.

        # No CORS headers added here — MinIO itself answers
        # Access-Control-* headers (including the PUT preflight) for the
        # origins in MINIO_API_CORS_ALLOW_ORIGIN in
        # storage-server/docker-compose.yml (bucket-level CORS is not used:
        # PutBucketCors does not work against MinIO), so this
        # proxy only needs to pass PUT/OPTIONS through untouched, not
        # duplicate or override what MinIO already sends.
    }

    # Everything else — / , /minio/health/*, /minio/admin/*, the bucket
    # root, other buckets, other prefixes — is answered here and never
    # forwarded. Readers go through the cache server, not this port.
    location / {
        return 403;
    }
}
